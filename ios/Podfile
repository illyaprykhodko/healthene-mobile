# Resolve react_native_pods.rb with node to allow for hoisting
def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '16.6'
prepare_react_native_project!
# NOTE `Release-Production` archives the App Store record (com.healthene.production.app);
# `Release` archives the staging record (com.healthene.app). Both must be declared here or
# CocoaPods generates no xcconfig for the extra configuration.
project 'Healthene.xcodeproj', 'Release-Production' => :release

setup_permissions([
  # 'AppTrackingTransparency',
  # 'Bluetooth', # Managed by react-native-ble-plx, not react-native-permissions
  # 'Calendars',
  # 'CalendarsWriteOnly',
  'Camera',
  # 'Contacts',
  'FaceID',
  # 'LocationAccuracy',
  # 'LocationAlways',
  'LocationWhenInUse',
  # 'MediaLibrary',
  # 'Microphone',
  # 'Motion',
  # 'Notifications',
  'PhotoLibrary',
  # 'PhotoLibraryAddOnly',
  # 'Reminders',
  # 'Siri',
  # 'SpeechRecognition',
  # 'StoreKit',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Healthene' do
  config_command = [
    'cat',
    File.join(__dir__, 'build/generated/autolinking/autolinking.json')
  ]
  config = use_native_modules!(config_command)

  pod 'react-native-blob-util',
      :path => '../node_modules/react-native-blob-util'

  # Firebase (Swift pods) + static libraries require modular headers
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # :hermes_enabled => false
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react_native_post_install resets every Pod target's IPHONEOS_DEPLOYMENT_TARGET to
    # React Native's min_ios_version_supported (e.g. 15.1). That leaves VisionCamera v5
    # (Nitro / Swift–C++ interop) compiling as `-target arm64-apple-ios15.1`, which has
    # triggered Swift/LLVM verifier crashes in Release (TestFlight) on newer Xcode SDKs,
    # and is below Google ML Kit 8.x requirements anyway. Align all Pods with the app.
    deployment_target = '16.6'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
      end
    end

    # VisionCamera v5 + Nitro use Swift C++ interop. On Xcode 16+ / iOS 26 SDK, Release
    # builds can crash swift-frontend during LLVM verify with:
    #   "Global is external, but doesn't have external or weak linkage"
    # when `LLVMCodeGenThreads` runs (`-num-threads 8` in the driver). This is a toolchain
    # bug, not app code. Disabling parallel WMO IR generation for these pods only avoids it.
    nitro_swift_interop_targets = %w[
      VisionCamera
      VisionCameraBarcodeScanner
      NitroModules
      NitroImage
      NitroSound
    ]
    installer.pods_project.targets.each do |target|
      next unless nitro_swift_interop_targets.include?(target.name)

      target.build_configurations.each do |bc|
        next unless bc.name.downcase.include?('release')

        bc.build_settings['SWIFT_USE_PARALLEL_WHOLE_MODULE_OPTIMIZATION'] = 'NO'
        bc.build_settings['SWIFT_ENABLE_BATCH_MODE'] = 'NO'
        bc.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
      end
    end
  end
end
