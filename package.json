{
  "name": "intelliceed_patientapp_mobile_v2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint src",
    "lint-auto-fix": "eslint src --fix",
    "start": "react-native start",
    "test": "jest",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android-local": "(adb devices | grep emulator) && cd android && ./gradlew clean installLocalDebug && cd ../",
    "android-local:apk": "cd android && ./gradlew clean assembleLocalRelease && cd ../",
    "android-local:aab": "cd android && ./gradlew clean bundleLocalRelease && cd ../",
    "android-development": "(adb devices | grep emulator) && cd android && ./gradlew clean installDevelopmentDebug && cd ../",
    "android-development:apk": "cd android && ./gradlew clean assembleDevelopmentRelease && cd ../",
    "android-development:aab": "cd android && ./gradlew clean bundleDevelopmentRelease && cd ../",
    "android-production": "(adb devices | grep emulator) && cd android && ./gradlew clean installProductionDebug && cd ../",
    "android-production:apk": "cd android && ./gradlew clean assembleProductionRelease && cd ../",
    "android-production:aab": "cd android && ./gradlew clean bundleProductionRelease && cd ../",
    "ios-local": "cd ios && xcodebuild -workspace intelliceed_patientapp_mobile_v2.xcworkspace -scheme local -configuration Debug -sdk iphonesimulator",
    "ios-development": "cd ios && xcodebuild -workspace intelliceed_patientapp_mobile_v2.xcworkspace -scheme development -configuration Debug -sdk iphonesimulator",
    "ios-production": "cd ios && xcodebuild -workspace intelliceed_patientapp_mobile_v2.xcworkspace -scheme production -configuration Debug -sdk iphonesimulator"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-material/core": "^1.3.7",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/drawer": "^7.3.12",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@react-navigation/stack": "^7.3.2",
    "@reduxjs/toolkit": "^2.8.1",
    "axios": "^1.9.0",
    "formik": "^2.4.6",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-config": "^1.5.5",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-indicators": "^0.17.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "^3.17.5",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.2.0",
    "redux-saga": "^1.3.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.16",
    "@types/moment": "^2.11.29",
    "@types/qs": "^6.9.18",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
