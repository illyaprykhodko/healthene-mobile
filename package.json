{
  "name": "healthene",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier \"src/**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,js,jsx,json,md}\" --check",
    "start": "react-native start",
    "test": "jest",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android-reactotron-start": "adb reverse tcp:9090 tcp:9090",
    "android-development-unix": "react-native run-android --mode=localdebug",
    "android-production-unix": "react-native run-android --mode=productiondebug",
    "emulator": "adb devices | grep emulator || (emulator -avd $(emulator -list-avds | head -n 1) -no-snapshot -no-boot-anim & sleep 30)",
    "android-local": "npm run emulator && cd android && ./gradlew clean installLocalDebug && cd ../",
    "android-local:light": "npm run emulator && cd android && ./gradlew installLocalDebug && cd ../",
    "android-local:apk": "cd android && ./gradlew clean assembleLocalRelease && cd ../",
    "android-local:aab": "cd android && ./gradlew clean bundleLocalRelease && cd ../",
    "android-development": "npm run emulator && cd android && ./gradlew clean installDevelopmentDebug && cd ../",
    "android-development:apk": "cd android && ./gradlew clean assembleDevelopmentRelease && cd ../",
    "android-development:apk:light": "cd android && ./gradlew assembleDevelopmentRelease && cd ../",
    "android-development:aab": "cd android && ./gradlew clean bundleDevelopmentRelease && cd ../",
    "android-production": "npm run emulator && cd android && ./gradlew clean installProductionDebug && cd ../",
    "android-production:apk": "cd android && ./gradlew clean assembleProductionRelease && cd ../",
    "android-production:apk:light": "cd android && ./gradlew assembleProductionRelease && cd ../",
    "android-production:aab": "cd android && ./gradlew clean bundleProductionRelease && cd ../",
    "ios-local": "react-native run-ios --scheme healthene_developmet_debug",
    "ios-development": "react-native run-ios --scheme healthene_developmet_debug",
    "ios-production": "react-native run-ios --scheme intelliceed_patientapp_mobile_v2 --mode Release"
  },
  "dependencies": {
    "@eslint/js": "^9.38.0",
    "@gorhom/bottom-sheet": "^5.2.6",
