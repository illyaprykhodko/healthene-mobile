{
    "permissions": {
        "allow": [
            "Bash(git status)",
            "Bash(git status:*)",
            "Bash(git diff)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch)",
            "Bash(git branch:*)",
            "Bash(git stash:*)",
            "Bash(git fetch:*)",
            "Bash(git remote -v)",
            "Bash(git remote)",
            "Bash(npm run lint)",
            "Bash(npm run lint:fix)",
            "Bash(npm run format)",
            "Bash(npm run format:check)",
            "Bash(npm test)",
            "Bash(npm test:*)",
            "Bash(npm start)",
            "Bash(npm run start)",
            "Bash(npm install)",
            "Bash(npm ci)",
            "Bash(npm outdated)",
            "Bash(npm outdated:*)",
            "Bash(npm audit)",
            "Bash(npm audit:*)",
            "Bash(npx jest:*)",
            "Bash(npx tsc --noEmit)",
            "Bash(npx tsc --noEmit:*)",
            "Bash(yarn lint)",
            "Bash(yarn lint:fix)",
            "Bash(yarn test)",
            "Bash(yarn format)",
            "Bash(node:*)",
            "Bash(ls:*)",
            "Bash(pwd)",
            "Bash(which:*)",
            "Bash(echo:*)",
            "Bash(rg:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(bundle exec pod install)",
            "Bash(pod install)"
        ],
        "deny": [
            "Bash(rm -rf:*)",
            "Bash(rm -fr:*)",
            "Bash(sudo:*)",
            "Bash(git push:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",
            "Bash(git rebase:*)",
            "Bash(git checkout --orphan:*)",
            "Bash(git branch -D:*)",
            "Bash(git filter-branch:*)",
            "Bash(git remote add:*)",
            "Bash(git remote set-url:*)",
            "Bash(npm publish:*)",
            "Bash(npm unpublish:*)",
            "Bash(npm config:*)",
            "Bash(npm login:*)",
            "Bash(npm token:*)",
            "Bash(curl:*)",
            "Bash(wget:*)",
            "Bash(cat .env:*)",
            "Bash(cat:.env*)",
            "Bash(printenv)",
            "Bash(printenv:*)",
            "Bash(env)",
            "Bash(security:*)",
            "Bash(keychain:*)",
            "Bash(open ~/.ssh:*)",
            "Bash(cat ~/.ssh/:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-secrets.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-command.sh"
                    }
                ]
            }
        ]
    }
}
